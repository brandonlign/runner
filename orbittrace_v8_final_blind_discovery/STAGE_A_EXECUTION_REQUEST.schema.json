{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orbittrace-v8-stage-a-execution-request-v1",
  "title": "OrbitTrace v8 Stage A execution request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "freeze_commit",
    "authorization_artifact_id",
    "authorization_artifact_sha256"
  ],
  "properties": {
    "schema": {
      "const": "orbittrace-v8-stage-a-execution-request-v1"
    },
    "freeze_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "authorization_artifact_id": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "authorization_artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
