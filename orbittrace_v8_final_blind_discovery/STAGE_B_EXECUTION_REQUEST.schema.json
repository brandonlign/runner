{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orbittrace-v8-stage-b-execution-request-v1",
  "title": "OrbitTrace v8 Stage B execution request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "freeze_commit",
    "stage_a_artifact_id",
    "stage_a_artifact_sha256",
    "withheld_reference_artifact_id",
    "withheld_reference_artifact_sha256"
  ],
  "properties": {
    "schema": {"const": "orbittrace-v8-stage-b-execution-request-v1"},
    "freeze_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "stage_a_artifact_id": {"type": "string", "pattern": "^[0-9]+$"},
    "stage_a_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "withheld_reference_artifact_id": {"type": "string", "pattern": "^[0-9]+$"},
    "withheld_reference_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
