{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orbittrace-withheld-reference-v1",
  "title": "OrbitTrace withheld GMN reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "events"],
  "properties": {
    "schema": {"const": "orbittrace-withheld-reference-v1"},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "month_key"],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "month_key": {
            "type": "string",
            "pattern": "^(202[2-5]-(0[1-9]|1[0-2])|2026-0[1-7])$"
          }
        }
      }
    }
  }
}
