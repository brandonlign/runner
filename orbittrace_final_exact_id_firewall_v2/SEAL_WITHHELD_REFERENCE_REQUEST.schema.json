    "development_run_id": {"type": "string", "pattern": "^[0-9]+$"},
    "literature_run_id": {"type": "string", "pattern": "^[0-9]+$"},
    "holdout_run_id": {"type": "string", "pattern": "^[0-9]+$"},
    "source_reference_artifact_id": {"type": "string", "pattern": "^[0-9]+$"},
    "source_reference_zip_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
